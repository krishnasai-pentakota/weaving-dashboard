# Copy this file to ".env" and fill in your own values.
#
# On the factory PC that holds the database, leave the host as localhost.
# On any other PC in the department, put the factory PC's name or address here.

WEAVING_DB_HOST=localhost
WEAVING_DB_PORT=5432
WEAVING_DB_NAME=weaving_db
WEAVING_DB_USER=weaving
WEAVING_DB_PASS=
